# 复制为 .env 后填写。.env 已在 .gitignore 中，绝不入库。
DATABASE_URL=postgresql://whu:whu_dev_password@127.0.0.1:5432/whu_teaching
DB_POOL_MAX=8
CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# ---------------------------------------------------------------------------
# 身份认证
# ---------------------------------------------------------------------------
# dev：身份取自请求头，仅本地使用；cas：接学校统一身份认证（尚未实现，调用会返回 501）
AUTH_MODE=dev
# 开发期未传 X-Roles 时使用的默认角色。生产（AUTH_MODE=cas）下不生效。
AUTH_DEV_ROLES=admin
# prod 且 AUTH_MODE=dev 时服务拒绝启动，防止"生产环境信任请求头"
APP_ENV=dev

# ---------------------------------------------------------------------------
# 模型：生成（DeepSeek / Kimi / 智谱 都是 OpenAI 兼容）
# ---------------------------------------------------------------------------
LLM_NAME=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# LLM_API_KEY=

# 模型：向量（阿里百炼）。维度必须与 vector(1024) 一致
EMBEDDING_NAME=bailian-qwen
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024
# EMBEDDING_API_KEY=

# 两条链路同一把密钥时可只配这一个
# MODEL_API_KEY=

# 出校策略：allowlist（默认）| any（仅开发）| internal-only（数据不出校）
MODEL_EGRESS=allowlist
# 逗号分隔，追加已批准的供应商域名
# MODEL_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# 密钥文件目录（0600）。库里只存文件名，不存密钥。
# 迁移服务器时必须单独搬这个目录，否则所有端点都会显示"未配置"。
# ---------------------------------------------------------------------------
SECRETS_DIR=./secrets

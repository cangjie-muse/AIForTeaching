# 复制到 /home/aiformath/AIForTeaching/.env，然后 chmod 600
# 只放服务端能读的密钥；前端永远不持有任何模型密钥。

# ---- 数据库 ----
DATABASE_URL=postgresql://whu:换成你的口令@127.0.0.1:5432/whu_teaching
DB_POOL_MAX=8

# ---- 运行环境 ----
# prod：cookie 带 Secure、关闭"开发期由后端托管静态站"、preflight 按生产口径检查。
# 注意：prod 下 FastAPI 不再提供 index.html 与静态文件，必须由 nginx 托管（见 deploy/nginx.conf.example）。
APP_ENV=prod
AUTH_MODE=password
DEV_FAKE_MODEL=0

# ---- 会话 cookie ----
# 留空：APP_ENV=prod 时自动带 Secure（要求 https 访问）。
# 域名与证书尚未到位、整站只能跑 http 时，临时填 0 才能登录；
# 拿到证书后删掉这一行（preflight 会一直提醒它）。
# COOKIE_SECURE=0

# ---- 前端来源 ----
# 同源部署（nginx 同时托管静态站与 /api）时这一项不影响访问，
# 但 preflight 会拒绝 *；填你自己的域名（https）。
# 还没有域名、先用 IP 时写 http://115.156.72.1
CORS_ORIGINS=https://你的域名

# ---- 生成模型（OpenAI 兼容；DeepSeek / Kimi / 智谱 / 百炼都可）----
LLM_NAME=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# ---- 向量模型（阿里百炼；维度必须 1024，与 textbook_chunk.embedding 一致）----
EMBEDDING_NAME=bailian-qwen
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=

# ---- 出校策略 ----
# 知识库没有依据时：model=改用模型通用知识回答（会标注）；off=严格拒答（论文/答辩场合）
QA_FALLBACK=model

MODEL_EGRESS=allowlist
# 火山方舟（Volcengine Ark）：ark.cn-beijing.volces.com；上海区是 -shanghai
MODEL_ALLOWED_HOSTS=api.deepseek.com,api.moonshot.cn,platform.kimi.com,dashscope.aliyuncs.com,dashscope-intl.aliyuncs.com,open.bigmodel.cn,ark.cn-beijing.volces.com,ark.cn-shanghai.volces.com

# ---- 存储 ----
# 教材 PDF 与抽取出的 markdown 落在这里，必须可写
UPLOAD_DIR=/home/aiformath/AIForTeaching/uploads
MAX_UPLOAD_MB=80
